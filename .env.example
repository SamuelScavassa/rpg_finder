# Copie para .env e preencha. NUNCA versione o .env.

# Domínio apontando (DNS tipo A) para o IP do servidor. O Caddy emite o HTTPS sozinho.
# Para testar só por IP, sem HTTPS: DOMAIN=:80 e PUBLIC_URL=http://IP-DO-SERVIDOR
DOMAIN=rpg.exemplo.com
PUBLIC_URL=https://rpg.exemplo.com

# Gere com:  openssl rand -hex 24      (use hex: evita caracteres que quebram a URL do banco)
POSTGRES_PASSWORD=

# Gere com:  openssl rand -hex 32      (mínimo 32 caracteres; a API recusa subir se for fraco)
JWT_SECRET=

# Opcional (minutos de validade do login)
JWT_EXPIRE_MINUTES=60
